{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File (Trace)",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {},
            "args": [
                "--trace",
                "${file}"
            ],
            "module": "trace"
        }
    ]
